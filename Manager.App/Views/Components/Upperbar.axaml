<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Manager.App.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="Manager.App.Views.Components.Upperbar">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/UpperbarStyle.axaml"/>
    </UserControl.Styles>

    <Border>
        <Grid ColumnDefinitions="48, *">
            <Button Grid.Column="0" 
                    Command="{Binding TogglePaneCommand}">
                <PathIcon
                    Data="{Binding IsPaneOpen,
                    Converter={StaticResource SidebarIconConverter}}" />
            </Button>  
        </Grid>
    </Border>
</UserControl>
