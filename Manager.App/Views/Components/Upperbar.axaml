<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Manager.App.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="Manager.App.Views.Components.Upperbar">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/UpperbarStyle.axaml"/>
    </UserControl.Styles>

    <Border>
        <Grid ColumnDefinitions="48, *">
            <Button Grid.Column="0" 
                    Command="{Binding TogglePaneCommand}">
                <Grid>
                    <PathIcon Data="{StaticResource sidebar_close_regular}"
                              IsVisible="{Binding IsPaneOpen}"/>

                    <PathIcon Data="{StaticResource sidebar_open_regular}"
                              IsVisible="{Binding IsPaneClosed}"/> 
                </Grid>
            </Button>  
        </Grid>
    </Border>
</UserControl>
