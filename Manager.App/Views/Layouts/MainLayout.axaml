<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Manager.App.ViewModels"
             xmlns:components="using:Manager.App.Views.Components"
             x:Class="Manager.App.Views.Layouts.MainLayout"
             x:DataType="vm:MainViewModel">


    <Grid RowDefinitions="45,*">

        <components:Upperbar Grid.Row="0"/>
        <components:Sidebar Grid.Row="1"/>
    </Grid>

</UserControl>
