<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Manager.App.Models"
             xmlns:vm="using:Manager.App.ViewModels"
             x:DataType="vm:ModsPageViewModel"
             x:Class="Manager.App.Views.ModsPageView">

    <Grid RowDefinitions="70, *">
        <Border Grid.Row="0" Background="#555555"
                CornerRadius="8 8 0 0">
            <TextBlock>
                Mods Mods Mods
            </TextBlock>
        </Border>
        <ListBox Grid.Row="1" 
                 Background="#1E1E1E"
                 ItemsSource="{Binding ModItems}">
            <ListBox.ItemTemplate>
                <DataTemplate >
					<Grid ColumnDefinitions="30,*,60,50">
						<CheckBox Grid.Column="0"
									IsChecked="{Binding IsEnabled}"/>

						<TextBlock Grid.Column="1"
									Text="{Binding Name}"/>

						<TextBlock Grid.Column="2"
									Text="{Binding Version}"/>

						<TextBlock Grid.Column="3"
									Text=""/>
					</Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
