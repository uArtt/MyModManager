<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Upperbar Body -->
    <Style Selector="Border">
        <Setter
            Property="Background"
            Value="#272741"/>

    </Style>

    <!-- Sidebar toggle button -->
    <Style Selector="Button">
        <Setter
            Property="Width"
            Value="28"/>
        <Setter
            Property="Height"
            Value="28"/>
        <Setter
            Property="Margin"
            Value="20"/>
        <Setter
            Property="HorizontalAlignment"
            Value="Center"/>
    </Style>

    <!-- Sidebar toggle icon -->
    <Style Selector="PathIcon">
        <Setter
            Property="Width"
            Value="13"/>
        <Setter
            Property="Height"
            Value="13"/>
    </Style>
</Styles>
